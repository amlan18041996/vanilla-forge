{
  // Cloudflare Workers configuration for the static Vite build.
  // `npm run deploy` builds the SPA and uploads `dist/` as static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vanilla-forge",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    // Client-side routes like /projects/calculator need to fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
